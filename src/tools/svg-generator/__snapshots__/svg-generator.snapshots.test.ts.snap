    <rect fill="#42c16b" height="40" width="40" x="200" y="400"></rect>
    <rect fill="#42c16b" height="80" width="40" x="280" y="420"></rect>
    <rect fill="#42c16b" height="72" width="40" x="360" y="388"></rect>
  </g>
  <g id="pie-chart">
    <rect fill="#102132" height="250" rx="12" stroke="#2d5d8f" width="480" x="560" y="390"></rect>
    <text fill="#f4f8fc" font-family="Segoe UI, Arial, sans-serif" font-size="20" font-weight="700" x="580" y="425">Pie Chart</text>
    <circle cx="800" cy="520" fill="#1a3348" r="90"></circle>
    <path d="M 800 520 L 800 430 A 90 90 0 0 1 872.812 572.901 Z" fill="#38a3ff"></path>
    <path d="M 800 520 L 872.812 572.901 A 90 90 0 0 1 747.099 592.812 Z" fill="#42c16b"></path>
    <path d="M 800 520 L 747.099 592.812 A 90 90 0 0 1 714.405 492.188 Z" fill="#f0b429"></path>
    <path d="M 800 520 L 714.405 492.188 A 90 90 0 0 1 800 430 Z" fill="#e25555"></path>
  </g>
  <g id="donut-chart">
