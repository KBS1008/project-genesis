    <path d="M 1392.812 572.901 A 90 90 0 0 1 1267.099 592.812 L 1293.55 556.406 A 45 45 0 0 0 1356.406 546.45 Z" fill="#42c16b"></path>
    <path d="M 1267.099 592.812 A 90 90 0 0 1 1234.405 492.188 L 1277.202 506.094 A 45 45 0 0 0 1293.55 556.406 Z" fill="#f0b429"></path>
    <path d="M 1234.405 492.188 A 90 90 0 0 1 1320 430 L 1320 475 A 45 45 0 0 0 1277.202 506.094 Z" fill="#e25555"></path>
  </g>
  <g id="scatter-plot">
