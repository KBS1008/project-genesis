    <circle cx="280" cy="480" fill="#e25555" r="6"></circle>
    <circle cx="340" cy="528" fill="#38a3ff" r="6"></circle>
    <circle cx="400" cy="390" fill="#42c16b" r="6"></circle>
  </g>
  <g id="gauge">
    <rect fill="#102132" height="180" rx="12" stroke="#2d5d8f" width="480" x="560" y="670"></rect>
    <text fill="#f4f8fc" font-family="Segoe UI, Arial, sans-serif" font-size="20" font-weight="700" x="580" y="705">Gauge</text>
    <path d="M 720 760 A 80 80 0 1 1 842.866 692.454" fill="none" stroke="#38a3ff" stroke-linecap="round" stroke-width="16"></path>
    <text fill="#f4f8fc" font-family="Segoe UI, Arial, sans-serif" font-size="28" font-weight="700" x="770" y="770">68%</text>
  </g>
  <g id="sparkline">
    <rect fill="#102132" height="180" rx="12" stroke="#2d5d8f" width="480" x="1080" y="670"></rect>
    <text fill="#f4f8fc" font-family="Segoe UI, Arial, sans-serif" font-size="20" font-weight="700" x="1100" y="705">Sparkline / Progress</text>
    <polyline fill="none" points="1120,780 1183.333,760 1246.667,770 1310,740 1373.333,746.667 1436.667,720 1500,726.667" stroke="#42c16b" stroke-width="2"></polyline>
    <rect fill="#1a3348" height="12" rx="6" width="360" x="1120" y="790"></rect>
    <rect fill="#42c16b" height="12" rx="6" width="250" x="1120" y="790"></rect>
  </g>
  <text fill="#9fc7ff" font-family="Segoe UI, Arial, sans-serif" font-size="16" x="40" y="870">Chart anatomy: axes, legend, labels, semantic colors, responsive viewBox</text>
  <text fill="#9fc7ff" font-family="Segoe UI, Arial, sans-serif" font-size="16" x="40" y="895">DD-042 placeholders: {{revenueHistory}} {{productionHistory}} {{marketShare}} {{playerName}} {{companyName}}</text>
  <text fill="#9fc7ff" font-family="Segoe UI, Arial, sans-serif" font-size="14" x="40" y="920">Accessibility: every chart includes title/desc metadata and non-color semantic labels.</text>
</svg>"
`;

