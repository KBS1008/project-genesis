// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shell and menu snapshots > matches MainMenuHome snapshot 1`] = `
<div>
  <div
    class="pg-shell"
  >
    <div
      class="pg-main-menu-home pg-menu-animate-in"
    >
      <div
        class="pg-main-menu-brand"
      >
        <h1>
          Project Genesis
        </h1>
        <p>
          Deterministische Wirtschafts- und Industriesimulation
        </p>
      </div>
      <p
        class="pg-main-menu-continue-hint"
        role="status"
      >
        Fortsetzen als 
        Nordindustrie AG
      </p>
      <div
        class="pg-main-menu-actions"
      >
        <button
          class="pg-button pg-button-primary"
          type="button"
        >
          Neues Spiel
        </button>
        <button
          class="pg-button pg-button-secondary"
          type="button"
        >
          Fortsetzen
        </button>
        <button
          class="pg-button pg-button-secondary"
          type="button"
        >
          Spiel laden
        </button>
        <button
          class="pg-button pg-button-secondary"
          type="button"
        >
          Einstellungen
        </button>
        <button
          class="pg-button pg-button-secondary"
          type="button"
        >
          Credits
        </button>
        <button
          class="pg-button pg-button-secondary"
          type="button"
        >
          Beenden
        </button>
      </div>
      <div
        class="pg-main-menu-footer"
      >
        <span>
          Version 
          0.1.0
        </span>
        <span>
          M11 · Application Shell
        </span>
      </div>
    </div>
    <div
      aria-live="polite"
      aria-relevant="additions"
      class="pg-notification-host"
    />
  </div>
</div>
`;

exports[`shell and menu snapshots > matches PGGlobalSearch snapshot 1`] = `
<div>
  <div
    class="pg-shell"
  >
    <div
      class="pg-global-search-backdrop"
      role="presentation"
    >
      <div
        aria-label="Globale Suche"
        aria-modal="true"
        class="pg-global-search-panel"
        role="dialog"
      >
        <input
          aria-controls="pg-global-search-results"
          aria-label="Globale Suche"
          class="pg-global-search-input"
          placeholder="Bildschirme und Entitäten suchen…"
          type="search"
          value=""
        />
        <div
          aria-label="Suchergebnisse"
          class="pg-global-search-results"
          id="pg-global-search-results"
          role="listbox"
        >
          <button
            aria-selected="true"
            class="pg-global-search-result is-active"
            role="option"
            type="button"
          >
            <span>
              Welt
